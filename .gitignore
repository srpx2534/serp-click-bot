# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build output
dist/
build/
*.tsbuildinfo
*.js.map

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Data directories (sensitive)
data/logs/*
data/cookies/*
!data/logs/.gitkeep
!data/cookies/imported/.gitkeep
!data/cookies/generated/.gitkeep
data/fingerprints/*.json
!data/fingerprints/index.json

# Config (sensitive)
config/proxies.json

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Test coverage
coverage/
.nyc_output/
*.lcov

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Optional: Lock files (if you want to ignore them)
